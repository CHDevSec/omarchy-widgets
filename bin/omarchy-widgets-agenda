#!/usr/bin/env python3
"""Write the week snapshot the Omarchy Widgets Week card shows.

Claude runs this with Google Calendar list_events responses it fetched
through its connector (JSON files shaped {events: [...]}):

    omarchy-widgets-agenda events.json [more.json ...]

Keeps title, start/end, colour, Meet link and event link; nothing else
(no descriptions or attendees) is written to disk.
"""
import json, os, re, sys
from datetime import datetime, timezone

DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "omarchy-widgets")
OUT = os.path.join(DATA, "agenda.json")
EMOJI = re.compile(r"[\U0001F000-\U0001FAFF☀-➿️‍]")


def main(paths):
    seen, events = set(), []
    for path in paths:
        with open(path) as f:
            for e in json.load(f).get("events", []):
                if e.get("status") == "cancelled" or e.get("id") in seen:
                    continue
                seen.add(e.get("id"))
                start, end = e.get("start", {}), e.get("end", {})
                title = e.get("summary") or "(sem título)"
                icon = "".join(EMOJI.findall(title)[:1])
                meet = e.get("hangoutLink") or ""
                for ep in (e.get("conferenceData") or {}).get("entryPoints", []):
                    if ep.get("entryPointType") == "video":
                        meet = meet or ep.get("uri", "")
                events.append({
                    "title": re.sub(r"\s+", " ", EMOJI.sub("", title)).strip(" -"),
                    "icon": icon,
                    "start": start.get("dateTime") or start.get("date"),
                    "end": end.get("dateTime") or end.get("date"),
                    "allDay": "date" in start and "dateTime" not in start,
                    "color": e.get("colorId") or "",
                    "meet": meet,
                    "url": e.get("htmlLink") or "",
                })
    events.sort(key=lambda e: e["start"] or "")
    os.makedirs(DATA, exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"updated": datetime.now(timezone.utc).isoformat(), "events": events}, f, ensure_ascii=False, indent=2)
    os.replace(tmp, OUT)
    print(f"{OUT}: {len(events)} events")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    main(sys.argv[1:])
