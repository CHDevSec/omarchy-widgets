#!/bin/sh
# Add a note to the Omarchy Widgets Notes card (its own file, or the
# Obsidian note set as style.notes.vaultFile when the card uses Obsidian).
#   omarchy-widgets-note "text"          a to-do
#   omarchy-widgets-note --note "text"   a plain note
set -eu
dir="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-widgets"
file="$dir/notes.md"
settings="$HOME/.local/state/omarchy-widgets/settings.json"
if [ -r "$settings" ] && [ "$(jq -r '.style.notes.source // "local"' "$settings" 2>/dev/null)" = obsidian ]; then
  vault=$(jq -r '.style.notes.vaultFile // ""' "$settings" 2>/dev/null)
  case "$vault" in "~/"*) vault="$HOME/${vault#\~/}" ;; esac
  [ -n "$vault" ] && file="$vault"
fi
mkdir -p "$(dirname "$file")"
mark="- [ ] "
if [ "${1:-}" = "--note" ]; then mark="- "; shift; fi
[ $# -gt 0 ] || { echo "usage: omarchy-widgets-note [--note] text" >&2; exit 2; }
# One line per note: newlines in the text would split it.
text=$(printf '%s' "$*" | tr '\n' ' ')
printf '%s%s\n' "$mark" "$text" >> "$file"
